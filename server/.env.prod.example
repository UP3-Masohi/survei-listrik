# Salin ke server/.env di VPS, lalu isi. File .env tidak masuk git.
# Password database (bebas, panjang). Dipakai Postgres dan API.
DB_PASSWORD=ganti-dengan-password-db-yang-panjang
# Rahasia JWT dan tanda tangan URL foto. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-rahasia-acak-64-hex
# Kosongkan bila aplikasi dan API satu domain lewat Nginx (/api). Isi bila aplikasi di domain lain (mis. GitHub Pages).
CORS_ORIGIN=
