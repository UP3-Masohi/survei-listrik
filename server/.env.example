# Koneksi PostgreSQL (di docker-compose sudah diisi otomatis)
DATABASE_URL=postgres://survei:survei@localhost:5432/survei
# Rahasia JWT, ganti dengan string acak panjang sebelum produksi
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang
# Domain PWA yang boleh memanggil API, pisahkan dengan koma
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Folder penyimpanan foto di disk
FOTO_DIR=./data/foto
PORT=3000
